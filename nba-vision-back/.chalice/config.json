{
  "version": "2.0",
  "app_name": "nbaspire",
  "stages": {
    "dev": {
      "api_gateway_stage": "dev",
      "manage_iam_role": true,
      "autogen_policy": true,
      "lambda_timeout": 360,
      "memory_size": 256,
      "environment_variables": {
        "MODEL_S3_BUCKET": "my-nba-models"
      },
      "cors": {
        "allow_origin": "*",
        "allow_headers": ["Content-Type", "Authorization"],
        "max_age": 600
      },
      "layers": [
        "arn:aws:lambda:eu-west-1:866605740825:layer:nba_predictor_core:1",
        "arn:aws:lambda:eu-west-1:866605740825:layer:nba_predictor_pandas:3",
        "arn:aws:lambda:eu-west-1:866605740825:layer:nba_predictor_sklearn:3"
      ],
      "package": {
        "no_deps": true,
        "ignore": [
          "venv*/**",
          "lambda-layer/**",
          "numpy*/**",
          "pandas*/**",
          "scipy*/**",
          "sklearn*/**",
          "*.dist-info/**",
          "*.pyc",
          "__pycache__/**"
        ],
        "extra_files": [
          {
            "source": "./models",
            "target": "./models"
          }
        ]
      }
    }
  }
}
